{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "name": "OrderHub API",
    "description": "REST API for OrderHub (Fastify on :3001).\n\n**Setup:** import `OrderHub.local.postman_environment.json`, select that environment, run **Login (Client)** or **Login (Admin)**, then **List products** before checkout.\n\nResponses use `{ \"status\": \"success\"|\"error\", \"data\": ... }` — match errors on `code`, not `message`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "productSlug", "value": "laptop-pro" },
    { "key": "orderId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const tokens = pm.response.json().data?.tokens;",
                  "  if (tokens) {",
                  "    pm.environment.set('accessToken', tokens.accessToken);",
                  "    pm.environment.set('refreshToken', tokens.refreshToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser-{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"New User\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "response": []
        },
        {
          "name": "Login (Client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const tokens = pm.response.json().data?.tokens;",
                  "  if (tokens) {",
                  "    pm.environment.set('accessToken', tokens.accessToken);",
                  "    pm.environment.set('refreshToken', tokens.refreshToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "response": []
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const tokens = pm.response.json().data?.tokens;",
                  "  if (tokens) {",
                  "    pm.environment.set('accessToken', tokens.accessToken);",
                  "    pm.environment.set('refreshToken', tokens.refreshToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "response": []
        },
        {
          "name": "Refresh tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const tokens = pm.response.json().data?.tokens;",
                  "  if (tokens) {",
                  "    pm.environment.set('accessToken', tokens.accessToken);",
                  "    pm.environment.set('refreshToken', tokens.refreshToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/logout"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/me"
          },
          "response": []
        },
        {
          "name": "Update me",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Updated\"\n}"
            },
            "url": "{{baseUrl}}/users/me"
          },
          "response": []
        },
        {
          "name": "List users (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const users = pm.response.json().data?.users;",
                  "  if (users?.length) {",
                  "    const client = users.find((u) => u.role === 'CLIENT') || users[0];",
                  "    pm.environment.set('userId', client.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users"
          },
          "response": []
        },
        {
          "name": "Get user by id (ADMIN/SUPPORT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const products = pm.response.json().data?.products;",
                  "  if (products?.length) {",
                  "    pm.environment.set('productId', products[0].id);",
                  "    pm.environment.set('productSlug', products[0].slug);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "List products (include inactive, ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?includeInactive=true",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "includeInactive", "value": "true" }]
            }
          },
          "response": []
        },
        {
          "name": "Get product by slug",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productSlug}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const p = pm.response.json().data?.product;",
                  "  if (p?.id) {",
                  "    pm.environment.set('productId', p.id);",
                  "    if (p.slug) pm.environment.set('productSlug', p.slug);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create product (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const p = pm.response.json().data?.product;",
                  "  if (p?.id) pm.environment.set('productId', p.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Gadget\",\n  \"slug\": \"postman-gadget-{{$timestamp}}\",\n  \"description\": \"Created from Postman\",\n  \"price\": \"29.99\",\n  \"stock\": 10\n}"
            },
            "url": "{{baseUrl}}/products"
          },
          "response": []
        },
        {
          "name": "Update product (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": \"27.99\",\n  \"stock\": 15\n}"
            },
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "response": []
        },
        {
          "name": "Deactivate product (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}/deactivate"
          },
          "response": []
        },
        {
          "name": "Activate product (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}/activate"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order (CLIENT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const order = pm.response.json().data?.order;",
                  "  if (order?.id) pm.environment.set('orderId', order.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/orders"
          },
          "response": []
        },
        {
          "name": "List my orders (CLIENT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/me?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "me"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get order by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}"
          },
          "response": []
        },
        {
          "name": "List all orders (ADMIN/SUPPORT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}

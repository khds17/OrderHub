# Copy to apps/api/.env. Loaded automatically by `dotenv/config` when running
# any script via `npm run … -w @orderhub/api` (cwd = apps/api).

DATABASE_URL=postgresql://orderhub:orderhub@localhost:5432/orderhub

# Generate locally with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string

PORT=3001
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development

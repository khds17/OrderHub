    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.2",

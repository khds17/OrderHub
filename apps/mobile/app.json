{
  "expo": {
    "name": "OrderHub",
    "slug": "orderhub",
    "scheme": "orderhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.orderhub.app" },
    "android": { "package": "com.orderhub.app" },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiUrl": "http://localhost:3001"
    }
  }
}
